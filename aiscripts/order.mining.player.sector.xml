<?xml version="1.0" encoding="utf-8"?>
<aiscript name="order.mining.player.sector" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd" priority="2"
  version="5">
  <!--
  Wrapper script for player mining in sector, starting mining.collect.ship
  -->
  <order id="MiningPlayerSector" name="{1972092409, 1}" description="{1972092409, 2}" category="mining" allowinloop="true">
    <params>
      <param name="location" required="true" type="sector" text="{1001, 2943}" comment="Destination. Sector to mine in." />
      <param name="ware" required="true" type="ware" text="{1041, 10144}" comment="Ware. Ware to mine.">
        <input_param name="cancarry" value="this.assignedcontrolled" />
        <input_param name="isminable" value="true" />
      </param>
      <param name="debugchance" type="bool" default="if @player.entity.$miningPlayerSectorConfig.$debugLog then 100 else 0" advanced="true" text="{1041, 10086}" comment="Print debug output">
        <input_param name="truevalue" value="100" />
      </param>
    </params>
    <skill min="20" />
    <requires primarypurpose="purpose.mine" />
    <location object="$targetSector" position="$targetPos" condition="@$targetPos != null" />
  </order>
  <interrupts>
    <library>
      <actions name="FindClosestAsteroidForMining">
        <find_asteroid_with_yield_in_sector name="$closestAsteroids" sector="$targetSector" refobject="$refObject" canpickup="false"
          maxdistance="$distance" ware="$ware" multiple="true" />
        <debug_text
          text="'MiningPlayerSector [%s]: asteroid search: found %s %s-bearing asteroid(s) in %s within %sm of %s.'.
              [this.assignedcontrolled.debugname, $closestAsteroids.count, $ware.name, $targetSector.knownname, $distance, $refObject.debugname]"
          chance="$debugchance" filter="scripts" />
        <do_if value="$closestAsteroids.count gt 0">
          <sort_list list="$closestAsteroids"
            sortbyvalue="$refObject.distanceto.{loop.element} + if loop.element.hascontext.{$targetSector} then 0 else $targetSector.coresize"
            sortdescending="false" />
          <set_value name="$closestAsteroid" exact="$closestAsteroids.{1}" />
          <debug_text text="'MiningPlayerSector [%s]: top asteroid candidate: %s, %sm from ref, %sm from ship.'.[this.assignedcontrolled.debugname, $closestAsteroid.debugname, $refObject.distanceto.{$closestAsteroid}, this.assignedcontrolled.distanceto.{$closestAsteroid}]" chance="$debugchance" filter="scripts" />
          <do_if value="@$closestAsteroid.hascontext.{$targetSector} != null">
            <create_position name="$targetPos" space="$targetSector" object="$closestAsteroid" min="200m" max="1km" />
            <debug_text
              text="'MiningPlayerSector [%s]: found %s-bearing asteroid %sm away, on distance %sm from %s'.
                  [this.assignedcontrolled.debugname, $ware, this.assignedcontrolled.distanceto.{$closestAsteroid}, $refObject.distanceto.{$closestAsteroid}, $refObject.debugname]"
              chance="$debugchance" filter="scripts" />
          </do_if>
          <do_else>
            <debug_text text="'MiningPlayerSector [%s]: asteroid %s is not in target sector %s - skipping'.[this.assignedcontrolled.debugname, $closestAsteroid.debugname, $targetSector.knownname]" chance="$debugchance" filter="scripts" />
          </do_else>
          <remove_value name="$closestAsteroid" />
        </do_if>
        <remove_value name="$closestAsteroids" />
      </actions>
    </library>
    <handler ref="AttackHandler" />
    <handler ref="MissileLockHandler" />
    <handler ref="ScannedHandler" />
    <handler ref="InspectedHandler" />
    <handler ref="FoundAbandonedHandler" />
    <handler ref="FoundLockboxHandler" />
    <handler ref="ResupplyHandler" />
    <handler ref="SectorChangeHandler" />
    <handler ref="TideHandler" />
  </interrupts>
  <init>
    <set_value name="$targetSector" exact="$location" />
    <set_value name="$targetPos" exact="null" />
    <set_value name="$resourceArea" exact="null" />

    <set_value name="$debugchance" exact="if @player.entity.$miningPlayerSectorConfig.$debugLog then 100 else 0" />

    <set_command command="command.freemining" />
    <debug_text text="'MiningPlayerSector [%s]: START - mining %s in %s (debugchance=%s).'.[this.assignedcontrolled.debugname, $ware.name, $targetSector.knownname, $debugchance]" chance="$debugchance" filter="scripts" />
  </init>
  <attention min="unknown">
    <actions>
      <do_if value="not this.assignedcontrolled.cargo.{$ware}.free">
        <wait min="2s" max="5s" />
        <do_if value="@this.assignedcontrolled.order.isrunning">
          <set_order_failed order="this.assignedcontrolled.order" text="{1045, 115}" comment="Not enough space in cargo hold." />
        </do_if>
        <do_if value="@player.entity.$miningPlayerSectorConfig.$logbook">
          <write_to_logbook category="general" title="{1972092409, 8008}"
            text="{1972092409, 8009}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode, $targetSector.knownname, $ware.name]"
            interaction="showonmap" object="this.assignedcontrolled"
            comment="%1 (%2) has stopped mining %4 in sector %3 - cargo hold is full." />
        </do_if>
        <debug_text text="'MiningPlayerSector [%s]: Cargo hold is full. Aborting.'.[this.assignedcontrolled.debugname]" chance="$debugchance" filter="scripts" />
        <resume label="cleanup" />
      </do_if>

      <do_if value="this.sector != $targetSector">

        <do_if
          value="@player.entity.$miningPlayerSectorConfig.$logbook">
          <write_to_logbook category="general" title="{1972092409, 8000}"
            text="{1972092409, 8001}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode, $targetSector.knownname, $ware.name]"
            interaction="showonmap" object="this.assignedcontrolled"
            comment="%1 (%2) is heading to sector %3 to mine %4." />
        </do_if>

        <get_jump_path component="$jumpPath" multiple="true" uselocalhighways="true" refobject="this.assignedcontrolled"
          useknownpath="this.isplayerowned">
          <start object="this.assignedcontrolled" />
          <end object="$targetSector" />
        </get_jump_path>

        <do_if value="$jumpPath.count lt 2">
          <debug_text
            text="'MiningPlayerSector [%s]: ERROR: we are not at the target sector, but no jump path found from %s to %s. Aborting.'.
            [
              this.assignedcontrolled.debugname,
              this.sector.knownname,
              $targetSector.knownname,
            ]" />
          <resume label="cleanup" />
        </do_if>

        <do_if value="@$jumpPath.last.zone != null">
          <set_value name="$targetLocation" exact="$jumpPath.last.zone" />
        </do_if>
        <do_else>
          <find_zone name="$targetLocation" space="targetSector" normalzone="true" sortbydistanceto="$jumpPath.last" />
        </do_else>

        <get_safe_pos result="$targetPos" zone="$targetLocation" radius="this.assignedcontrolled.size" min="1km" max="5km" object="$jumpPath.last" />

        <remove_value name="$jumpPath" />

        <run_script name="'move.generic'" result="$movesuccess">
          <param name="destination" value="$targetLocation" />
          <param name="position" value="$targetPos" />
          <!--<param
          name="endintargetzone" value="true"/>-->
          <param name="debugchance" value="$debugchance" />
        </run_script>
        <do_if value="not $movesuccess">
          <do_if value="@this.assignedcontrolled.order.isrunning">
            <set_order_failed order="this.assignedcontrolled.order" text="{1045, 101}" comment="Unable to reach destination." />
          </do_if>
          <debug_text text="'MiningPlayerSector [%s]: Unable to reach destination. Aborting.'.[this.assignedcontrolled.debugname]" chance="$debugchance" filter="scripts" />
          <resume label="cleanup" />
        </do_if>
      </do_if>

      <set_value name="$targetPos" exact="null" />

      <wait min="2s" max="5s" chance="0" />

      <do_if
        value="@player.entity.$miningPlayerSectorConfig.$logbook">
        <write_to_logbook category="general" title="{1972092409, 8002}"
          text="{1972092409, 8003}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode, $targetSector.knownname, $ware.name]"
          interaction="showonmap" object="this.assignedcontrolled"
          comment="%1 (%2) is scanning sector %3 for %4." />
      </do_if>

      <find_object name="$resourceProbes" class="class.resourceprobe" space="$targetSector" owner="faction.player" multiple="true" />
      <debug_text text="'MiningPlayerSector [%s]: found %s resource probe(s) in %s.'.[this.assignedcontrolled.debugname, $resourceProbes.count, $targetSector.knownname]" chance="$debugchance" filter="scripts" />
      <do_if value="$resourceProbes.count">
        <sort_list list="$resourceProbes" sortbyvalue="loop.element.currentyield.{$ware}.count" sortdescending="true" />
        <set_value name="$bestProbe" exact="null" />
        <set_value name="$bestCurrentYield" exact="0" />
        <set_value name="$bestDistance" exact="0" />
        <do_for_each name="$probe" in="$resourceProbes">
          <do_if value="$probe.isoperational">
            <set_value name="$probeCurrentYield" exact="$probe.currentyield.{$ware}.count" />
            <debug_text text="'MiningPlayerSector [%s]: probe %s: currentyield=%s for %s'.[this.assignedcontrolled.debugname, $probe.debugname, $probeCurrentYield, $ware.name]" chance="$debugchance" filter="scripts" />
            <do_if value="$probeCurrentYield == 0">
              <!-- probe detects no ore in this area - and since list is sorted descending, all following probes also have 0 -->
              <debug_text text="'MiningPlayerSector [%s]: probe %s has 0 currentyield for %s - stopping search'.[this.assignedcontrolled.debugname, $probe.debugname, $ware.name]" chance="$debugchance" filter="scripts" />
              <remove_value name="$probeCurrentYield" />
              <break />
            </do_if>
            <do_else>
              <set_value name="$probeDistance" exact="this.assignedcontrolled.distanceto.{$probe}" />
              <do_if value="$bestProbe == null">
                <!-- first probe with non-zero yield becomes initial best -->
                <set_value name="$bestProbe" exact="$probe" />
                <set_value name="$bestCurrentYield" exact="$probeCurrentYield" />
                <set_value name="$bestDistance" exact="$probeDistance" />
                <debug_text text="'MiningPlayerSector [%s]: initial best probe %s (currentyield=%s, distance=%sm)'.[this.assignedcontrolled.debugname, $bestProbe.debugname, $bestCurrentYield, $bestDistance]" chance="$debugchance" filter="scripts" />
              </do_if>
              <do_else>
                <!-- list is sorted descending so probeCurrentYield <= bestCurrentYield -->
                <!-- if more than 10% below best yield, stop - no point checking further -->
                <do_if value="($bestCurrentYield - $probeCurrentYield) * 1.0f / $bestCurrentYield gt 0.1f">
                  <debug_text text="'MiningPlayerSector [%s]: probe %s currentyield=%s more than 10%% below best %s - stopping search'.[this.assignedcontrolled.debugname, $probe.debugname, $probeCurrentYield, $bestCurrentYield]" chance="$debugchance" filter="scripts" />
                  <remove_value name="$probeDistance" />
                  <remove_value name="$probeCurrentYield" />
                  <break />
                </do_if>
                <!-- within 10% of best yield - pick closer one -->
                <do_elseif value="$probeDistance lt $bestDistance">
                  <set_value name="$bestProbe" exact="$probe" />
                  <set_value name="$bestCurrentYield" exact="$probeCurrentYield" />
                  <set_value name="$bestDistance" exact="$probeDistance" />
                  <debug_text text="'MiningPlayerSector [%s]: new best probe %s (closer, currentyield=%s, dist=%sm)'.[this.assignedcontrolled.debugname, $bestProbe.debugname, $bestCurrentYield, $bestDistance]" chance="$debugchance" filter="scripts" />
                </do_elseif>
                <do_else>
                  <debug_text text="'MiningPlayerSector [%s]: probe %s not better (currentyield=%s, dist=%sm vs best %sm)'.[this.assignedcontrolled.debugname, $probe.debugname, $probeCurrentYield, $probeDistance, $bestDistance]" chance="$debugchance" filter="scripts" />
                </do_else>
              </do_else>
              <remove_value name="$probeDistance" />
            </do_else>
            <remove_value name="$probeCurrentYield" />
          </do_if>
        </do_for_each>
        <do_if value="$bestProbe?">
          <do_if value="this.isplayerowned and this.assignedcontrolled.attention ge attention.visible and $ware.hastag.mineral">
            <debug_text
              text="'MiningPlayerSector [%s]: going to search asteroid using resource probe %s in %s for %s (currentyield=%s, dist=%sm)'.
              [this.assignedcontrolled.debugname, $bestProbe.debugname, $targetSector.knownname, $ware, $bestCurrentYield, $bestDistance]"
              chance="$debugchance" filter="scripts" />
            <set_value name="$distance" exact="this.assignedcontrolled.currentradarrange" />
            <set_value name="$refObject" exact="$bestProbe" />
            <include_interrupt_actions ref="FindClosestAsteroidForMining" />
            <remove_value name="$refObject" />
            <remove_value name="$distance" />
          </do_if>
          <debug_text text="'MiningPlayerSector [%s]: after probe %s asteroid search: targetPos=%s'.[this.assignedcontrolled.debugname, $bestProbe.debugname, @$targetPos]" chance="$debugchance" filter="scripts" />
          <do_if value="not $targetPos? or @$targetPos == null">
            <find_closest_resource sector="$targetSector" position="$targetPos" ware="$ware" refobject="$bestProbe"
              minrating="1" useundiscovered="false" distance="$distance" />
            <debug_text
              text="'MiningPlayerSector [%s]: using resource probe %s in %s for %s (currentyield=%s). Point at distance %s, from probe: %s'.
              [this.assignedcontrolled.debugname, $bestProbe.debugname, $targetSector.knownname, $ware, $bestCurrentYield, this.assignedcontrolled.distanceto.[$targetSector, $targetPos], $distance]"
              chance="$debugchance" filter="scripts" />
            <remove_value name="$distance" />
          </do_if>
        </do_if>
        <do_else>
          <debug_text text="'MiningPlayerSector [%s]: no operational probe found for %s in %s'.[this.assignedcontrolled.debugname, $ware.name, $targetSector.knownname]" chance="$debugchance" filter="scripts" />
        </do_else>
        <remove_value name="$bestCurrentYield" />
        <remove_value name="$bestProbe" />
        <remove_value name="$bestDistance" />
      </do_if>
      <remove_value name="$resourceProbes" />

      <do_if value="not $targetPos? or @$targetPos == null">
        <debug_text text="'MiningPlayerSector [%s]: no position from probes - direct sector search for %s in %s'.[this.assignedcontrolled.debugname, $ware.name, $targetSector.knownname]" chance="$debugchance" filter="scripts" />
        <do_if value="this.isplayerowned and this.assignedcontrolled.attention ge attention.visible and $ware.hastag.mineral">
          <debug_text
            text="'MiningPlayerSector [%s]: going to search asteroid in sector: %s.'.[this.assignedcontrolled.debugname, $targetSector.knownname]" chance="$debugchance"
            filter="scripts" />
          <set_value name="$distance" exact="[this.assignedcontrolled.currentradarrange, $targetSector.coresize].max" />
          <set_value name="$refObject" exact="this.assignedcontrolled" />
          <include_interrupt_actions ref="FindClosestAsteroidForMining" />
          <remove_value name="$refObject" />
        </do_if>
        <do_else>
          <debug_text text="'MiningPlayerSector [%s]: skipping asteroid search - ware %s is gas or ship is not visible'.[this.assignedcontrolled.debugname, $ware.name]" chance="$debugchance" filter="scripts" />
        </do_else>
        <do_if value="not $targetPos? or @$targetPos == null">
          <find_closest_resource sector="$targetSector" position="$targetPos" ware="$ware" refobject="this.assignedcontrolled"
            useundiscovered="false" distance="$distance" />
          <debug_text
            text="'MiningPlayerSector [%s]: usable concentrations of %s found in %s, %sm away from ship.'.
            [this.assignedcontrolled.debugname, $ware.name, $targetSector.knownname, $distance]"
            chance="$debugchance" filter="scripts" />
          <remove_value name="$distance" />
        </do_if>
        <remove_value name="$distance" />
      </do_if>

      <do_if value="$targetPos? and @$targetPos != null">
        <debug_text
          text="'MiningPlayerSector [%s]: collecting %s at %s in %s via order.mining.collect.ship script'.[this.assignedcontrolled.debugname, $ware.name, $targetPos, $targetSector.knownname]"
          chance="$debugchance" filter="scripts" />
        <!-- v9: get resourceArea for yield reservation -->
        <find_closest_resource resourcearea="$resourceArea" ware="$ware" sector="$tmpSector" position="$tmpPos"
          refobject="$targetSector">
          <refposition value="$targetPos" object="$targetSector" />
        </find_closest_resource>
        <do_if value="@$resourceArea != null">
          <add_yield_reservation reserver="this.assignedcontrolled" resourcearea="$resourceArea" />
          <debug_text text="'MiningPlayerSector [%s]: yield reservation added for resourceArea %s'.[this.assignedcontrolled.debugname, $resourceArea]" chance="$debugchance" filter="scripts" />
        </do_if>
        <do_else>
          <debug_text text="'MiningPlayerSector [%s]: no resourceArea found at position %s - proceeding without reservation'.[this.assignedcontrolled.debugname, $targetPos]" chance="$debugchance" filter="scripts" />
        </do_else>
        <remove_value name="$tmpSector" />
        <remove_value name="$tmpPos" />
        <do_if
          value="@player.entity.$miningPlayerSectorConfig.$logbook">
          <write_to_logbook category="general" title="{1972092409, 8004}"
            text="{1972092409, 8005}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode, $targetSector.knownname, $ware.name]"
            interaction="showonmap" object="this.assignedcontrolled"
            comment="%1 (%2) has finished scanning sector %3 and is now mining %4." />
        </do_if>
        <set_command command="command.mining" param="$targetSector" />
        <set_value name="$miningCollect" />
        <run_script name="'order.mining.collect.ship'" result="$collectResult">
          <param name="destination" value="[$targetSector, $targetPos]" />
          <param name="ware" value="$ware" />
          <param name="resourcearea" value="@$resourceArea" />
          <param name="debugchance" value="$debugchance" />
        </run_script>
        <run_script name="'lib.recall.subordinates'" />
        <remove_value name="$miningCollect" />

        <do_if value="@this.assignedcontrolled.order.isrunning">
          <do_if value="($collectResult == 'nodrones')">
            <set_order_failed order="this.assignedcontrolled.order" text="{1045,138}" comment="No available mining drones." />
          </do_if>
          <do_if value="($collectResult == 'miningrig_nosubordinates')">
            <set_order_failed order="this.assignedcontrolled.order" text="{1045,162}" comment="No mining subordinates." />
          </do_if>
        </do_if>
      </do_if>
      <do_else>
        <set_order_failed order="this.assignedcontrolled.order" text="{1045, 105}" comment="No resources found." />
        <set_value name="$collectResult" exact="'no_resources'" />
      </do_else>

      <do_if value="$collectResult != 'aborted'">
        <do_if value="@player.entity.$miningPlayerSectorConfig.$logbook">
          <write_to_logbook category="general" title="{1972092409, 8006}"
            text="{1972092409, 8007}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode, $targetSector.knownname, $ware.name]"
            interaction="showonmap" object="this.assignedcontrolled"
            comment="%1 (%2) has finished mining %4 in sector %3." />
        </do_if>
        <do_if value="$ware.hastag.liquid">
          <set_value name="$infomining" exact="{1015,24}" comment="Info: gas mining stopped" />
        </do_if>
        <do_else>
          <set_value name="$infomining" exact="{1015,25}" comment="Info: mineral mining stopped" />
        </do_else>

        <do_if value="this.isplayerowned and not this.isclass.computer">
          <do_if value="$collectResult != 'no_resources'">
            <do_if
              value="not this.assignedcontrolled.nextorder and (not this.assignedcontrolled.commander or (this.assignedcontrolled.commander == player.occupiedship)) and notification.npc_await_orders.active">
              <run_script name="'player.interaction'">
                <param name="Line" value="10304" comment="Awaiting orders." />
                <param name="MaxQueueDelay" value="10s" />
                <param name="caption" value="$infomining + ' - ' + {1016,6}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode]"
                  comment="Info: (24: gas, 25: mineral) mining stopped" />
                <param name="interactive" value="false" />
                <param name="debugchance" value="$debugchance" />
              </run_script>
            </do_if>
          </do_if>
          <do_elseif value="this.shouldwarnplayer and notification.npc_order_not_complete.active">
            <run_script name="'player.interaction'" sinceversion="1">
              <param name="Line" value="10303" comment="Last order could not be completed." />
              <param name="MaxQueueDelay" value="10s" />
              <param name="caption" value="$infomining + ' - ' + {1016,6}.[this.assignedcontrolled.knownname, this.assignedcontrolled.idcode]"
                comment="Info: (24: gas, 25: mineral) mining stopped" />
              <param name="interactive" value="false" />
              <param name="debugchance" value="$debugchance" />
            </run_script>
          </do_elseif>
        </do_if>
      </do_if>

      <label name="cleanup" />

      <do_if value="@$resourceArea != null">
        <remove_yield_reservation reserver="this.assignedcontrolled" resourcearea="$resourceArea" />
      </do_if>

      <wait min="2s" max="5s" />

    </actions>
  </attention>
  <on_abort>
    <do_if value="not $miningCollect? and @$resourceArea != null">
      <remove_yield_reservation reserver="this.assignedcontrolled" resourcearea="$resourceArea" />
    </do_if>
  </on_abort>
</aiscript>